{
	"version": "0.2.0",
	"configurations": [
	  {
		"name": "Full App",
		"type": "node",
		"request": "launch",
		"runtimeExecutable": "npm",
		"runtimeArgs": [
		  "run",
		  "dev"
		],
		"port": 9229,
		"skipFiles": [
		  "<node_internals>/**"
		]
	  },
	  {
		"name": "Frontend",
		"type": "chrome",
		"request": "launch",
		"url": "http://localhost:3000",
		"webRoot": "${workspaceFolder}",
		"sourceMaps": true,
		"sourceMapPathOverrides": {
		  "webpack:///./*": "${webRoot}/*"
		}
	  }
	]
  }
  